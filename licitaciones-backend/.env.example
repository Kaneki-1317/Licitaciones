# Variables de entorno del backend (licitaciones-backend).
#
# Spring Boot NO carga este archivo automaticamente (a diferencia del
# frontend Vite): esto es solo referencia/documentacion de que variables
# existen. Para usarlas en local, expórtalas en tu shell/IDE (o con un
# plugin como `dotenv` si tu equipo ya usa uno) antes de arrancar la app;
# en Render, se cargan en Settings -> Environment.
#
# NUNCA pongas valores reales en este archivo ni lo edites con la
# contrasena real: es el que se commitea al repo como plantilla.

# ---------------------------------------------------------------------
# MySQL (Aiven en produccion; sin definir, cae en 127.0.0.1:3306/licitaciones_db)
# ---------------------------------------------------------------------
DB_HOST=mysql-1d20ba80-cristiandres1317-5d38.l.aivencloud.com
DB_PORT=21874
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
# PREFERRED en local (no rompe MySQL local con o sin TLS). En Render/Aiven: REQUIRED.
DB_SSL_MODE=REQUIRED

# ---------------------------------------------------------------------
# JWT (ver auth.JwtService) -- generar un valor propio, nunca usar el
# default de desarrollo en produccion
# ---------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION=86400000

# ---------------------------------------------------------------------
# Usuario administrador inicial (ver config.AdminUsuarioInitializer) --
# solo hace falta la primera vez que arranca contra una base sin usuarios
# ---------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------
# CORS: origen de desarrollo (ya trae default) + origen de produccion
# (dominio de Vercel), opcional
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=

# ---------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------
N8N_BASE_URL=
N8N_WEBHOOK_ANALIZAR=

# ---------------------------------------------------------------------
# Puerto (Render lo define solo; en local, sin definir, usa 8080)
# ---------------------------------------------------------------------
PORT=8080

# ---------------------------------------------------------------------
# Esquema de base de datos: "update" en desarrollo (default, no lo
# cambies aqui). En Render, definir JPA_DDL_AUTO=validate -- ya se
# verifico que el esquema real de Aiven coincide exactamente con las
# entidades JPA (usuarios/proceso_licitacion/resultado_analisis), asi que
# "validate" es seguro ahi: Hibernate solo verifica el esquema al
# arrancar, nunca crea/altera/borra tablas.
# ---------------------------------------------------------------------
JPA_DDL_AUTO=update
