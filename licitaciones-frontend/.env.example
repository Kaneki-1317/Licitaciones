# URL base del backend Spring Boot (sin barra final)

# Local (desarrollo): backend corriendo con ./mvnw spring-boot:run
VITE_API_BASE_URL=http://localhost:8080

# Produccion (Vercel): NO se pone aqui -- este archivo es solo referencia,
# .env real esta gitignored y Vercel no lo lee. En Vercel, configura esta
# misma variable (Project Settings -> Environment Variables) con la URL
# publica que te da Render despues del deploy, algo como:
#   VITE_API_BASE_URL=https://<nombre-del-servicio>.onrender.com
